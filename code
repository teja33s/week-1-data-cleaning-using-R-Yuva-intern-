# 12. Descriptive statistics
descriptive_stats <- data.frame(
  Variable = numeric_cols,
  Mean = sapply(data[numeric_cols], mean),
  Median = sapply(data[numeric_cols], median),
  SD = sapply(data[numeric_cols], sd),
  Minimum = sapply(data[numeric_cols], min),
  Maximum = sapply(data[numeric_cols], max)
)

print(descriptive_stats)

write.csv(
  descriptive_stats,
  "output/descriptive_statistics.csv",
  row.names = FALSE
