dev.off()

# 14. Preliminary insight: survival rates
survival_by_class <- data %>%
  group_by(pclass) %>%
  summarise(
    Passengers = n(),
    Survival_Rate = mean(survived) * 100,
    .groups = "drop"
  )

print(survival_by_class)

write.csv(
  survival_by_class,
  "output/survival_by_class_summary.csv",
  row.names = FALSE
)

# Survival rate by sex
survival_by_sex <- data %>%
  group_by(sex) %>%
  summarise(
    Passengers = n(),
    Survival_Rate = mean(survived) * 100,
    .groups = "drop"
  )

print(survival_by_sex)

write.csv(
  survival_by_sex,
  "output/survival_by_sex.csv",
  row.names = FALSE
